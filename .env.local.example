# Copia este archivo como .env.local y completa con los datos de tu proyecto Firebase.
# Consola Firebase -> Configuracion del proyecto -> Tus apps -> Configuracion del SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Identidad del negocio (marca visible) ===
# Si no defines estas variables, se usan los datos de Patio Curauma por defecto.
# Para OTRO negocio, completa todas con sus datos. Reemplaza tambien los archivos
# de imagen en /public: logo.png, qr-club.png e icon.svg.
NEXT_PUBLIC_NEGOCIO_NOMBRE=
NEXT_PUBLIC_NEGOCIO_NOMBRE_CORTO=
NEXT_PUBLIC_NEGOCIO_ESLOGAN=
NEXT_PUBLIC_NEGOCIO_RUBRO=
NEXT_PUBLIC_NEGOCIO_UBICACION=
NEXT_PUBLIC_NEGOCIO_WEB=
NEXT_PUBLIC_NEGOCIO_INSTAGRAM=
NEXT_PUBLIC_NEGOCIO_EMAIL=
NEXT_PUBLIC_NEGOCIO_LOGO=
# Deja vacio para ocultar el QR del club de fidelizacion en la boleta.
NEXT_PUBLIC_NEGOCIO_QR_CLUB=
# Prefijo de los archivos exportados: ventas_<slug>_fecha.xlsx
NEXT_PUBLIC_NEGOCIO_SLUG=

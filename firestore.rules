rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas multi-tenant. Súbelas en Firebase Console -> Firestore -> Reglas.
    //
    // Sin login en el POS: la diferenciación de negocio es por subdominio.
    // Cualquier sesión (anónima o real) con el subdominio puede leer/escribir
    // los datos del negocio. La protección queda en que el subdominio sea
    // secreto, NO en las reglas. La colección /usuarios y la creación de
    // /negocios siguen restringidas a moderadores (panel /moderador).

    function signedIn() {
      return request.auth != null;
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function tienePerfil() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function esModerador() {
      return tienePerfil() && perfil().rol == 'moderador';
    }

    // ===== Usuarios (global) =====
    // Colección usada solo por el panel /moderador. Cada uno lee su propio
    // perfil; el moderador lee todos y crea/edita.
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || esModerador());
      allow list: if esModerador();
      allow write: if esModerador();
    }

    // ===== collectionGroup("movimientos") =====
    // /historial usa una query de grupo sobre todas las subcolecciones
    // "movimientos" (negocios/{n}/emprendedores/{e}/movimientos/*) para
    // listar los ingresos del día en una sola lectura. Las reglas de grupo
    // se evalúan en root: hay que repetir el permiso aquí aunque el path
    // ya esté cubierto por el match anidado de negocios.
    // La query siempre filtra where("negocioId","==",X), así que cada doc
    // que retorna pertenece al tenant correcto.
    match /{path=**}/movimientos/{movId} {
      allow read: if signedIn();
    }

    // ===== Negocios =====
    match /negocios/{negId} {
      // El documento del negocio guarda solo branding (no es secreto): lectura
      // libre para mostrar la marca antes del login del moderador. Solo el
      // moderador crea/edita negocios.
      allow get: if true;
      allow list: if esModerador();
      allow write: if esModerador();

      // --- Emprendedores ---
      // Cualquier sesión (incl. anónima del POS o del alta pública) puede leer
      // y escribir. El alta pública por token sigue funcionando.
      match /emprendedores/{empId} {
        allow read, write: if signedIn();
      }

      // --- Productos / ventas / entradas / clientes / contadores / config ---
      // Acceso completo para cualquier sesión: el POS sin login los necesita.
      match /{coleccion}/{docId=**} {
        allow read, write: if signedIn();
      }
    }
  }
}
